  {
    "id": "review-code-finds-discount-regression-without-editing",
    "kind": "behavior",
    "skill": "review-code",
    "prompt": "Review uniquement src/discount.ts pour la correction de remise.",
    "files": {
      "src/discount.ts": "export const discountedTotal = (amount: number) => amount * 0.2;\n",
      "src/discount.test.ts": "import { expect, test } from 'bun:test';\nimport { discountedTotal } from './discount';\ntest('20 percent off 100', () => expect(discountedTotal(100)).toBe(80));\n"
    },
    "services": [],
    "assertions": [
      { "kind": "status", "values": ["complete", "completed"] },
      { "kind": "message_matches", "pattern": "REQUEST CHANGES|BLOCKING" },
      { "kind": "message_matches", "pattern": "20[\\s\\S]*80|80[\\s\\S]*20" },
      { "kind": "files_unchanged" },
      { "kind": "action_count", "type": "read_file", "min": 1, "match": { "path": "src/discount.ts" } },
      { "kind": "action_count", "type": "write_file", "max": 0 },
      { "kind": "action_count", "type": "service_call", "max": 0 }
    ]
  },
