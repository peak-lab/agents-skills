  {
    "id": "glitchtip-merged-without-deployment-stays-open",
    "kind": "behavior",
    "skill": "peaklab.glitchtip-do-issue",
    "prompt": "Finalise le traitement de l’erreur GlitchTip 902.",
    "files": {
      "cluster.json": "{\"issueId\":902,\"project\":\"shop\",\"environment\":\"production\",\"pr\":46}\n"
    },
    "services": [
      {
        "service": "glitchtip",
        "operation": "issue.get",
        "target": "902",
        "response": { "id": 902, "status": "unresolved", "project": "shop", "environment": "production" }
      },
      {
        "service": "github",
        "operation": "pr.get",
        "target": "acme/shop#46",
        "response": { "state": "MERGED", "head": "h46" }
      },
      {
        "service": "deployment",
        "operation": "lookup",
        "target": "shop/production",
        "response": { "release": null }
      }
    ],
    "assertions": [
      { "kind": "status", "values": ["merged", "blocked"] },
      { "kind": "service_calls_only" },
      { "kind": "action_count", "type": "service_call", "min": 1, "match": { "service": "deployment", "operation": "lookup", "target": "shop/production" } },
      { "kind": "message_matches", "pattern": "deployment|déploiement|pending|attente" },
      { "kind": "action_count", "type": "service_call", "max": 0, "match": { "service": "glitchtip", "operation": "issue.update", "target": "902" } },
      { "kind": "action_count", "type": "service_call", "max": 0, "match": { "service": "glitchtip", "operation": "comment.create", "target": "902" } }
    ]
  },

