      { "kind": "action_count", "type": "service_call", "max": 0 }
    ]
  },
  {
    "id": "apex-happy-fix-writes-discount-configuration",
    "kind": "behavior",
    "skill": "apex",
    "prompt": "Configure la remise à 20 % et vérifie le résultat.",
    "files": {
      "config.json": "{\"discountPercent\":0}\n",
      "package.json": "{\"scripts\":{\"test\":\"bun test\"}}\n"
    },
    "services": [
      {
        "service": "shell",
        "operation": "run",
        "target": "bun test",
        "response": { "exitCode": 0, "stdout": "1 pass" }
      }
    ],
    "assertions": [
      { "kind": "status", "values": ["complete", "completed"] },
      {
        "kind": "file_json_value",
        "path": "config.json",
        "keys": ["discountPercent"],
        "value": 20
      },
      { "kind": "action_count", "type": "write_file", "min": 1, "max": 1, "match": { "path": "config.json" } },
      { "kind": "action_count", "type": "service_call", "min": 1, "match": { "service": "shell", "operation": "run", "target": "bun test" } }
    ]
  },
