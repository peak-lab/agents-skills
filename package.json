{
  "name": "@peak-lab/agents",
  "version": "0.0.0",
  "private": true,
  "description": "Safely install Peak Lab native agent definitions.",
  "type": "module",
  "bin": {
    "peaklab-agents": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "agents",
    "docs/agents.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check:portability": "bun scripts/check-portability.ts",
    "eval:skills": "bun scripts/eval-skills.ts",
    "eval:check": "bun scripts/eval-skills.ts --check",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --target node --outdir dist",
    "prepack": "bun run build",
    "smoke:package": "bun run build && bun run scripts/smoke-package.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  }
}
